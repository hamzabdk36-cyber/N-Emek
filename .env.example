# N-Emek ortam değişkenleri — örnek dosya
#
# Kopyalayın ve düzenleyin:   cp .env.example .env
#
# Hiçbiri zorunlu değil; hepsinin kodda bir varsayılanı var
# (`backend/app/core/config.py`). Bu dosya "hangi düğmeler var" sorusunun
# cevabı — daha önce bunu öğrenmenin tek yolu kaynağı okumaktı.
#
# Önek `NEMEK_`, büyük/küçük harf duyarsız. Değerler ayrıca kabuk ortam
# değişkeni olarak da verilebilir; ortam değişkeni .env dosyasını ezer.

# ---------------------------------------------------------------------------
# Oturum — üretimde okunması gereken tek satır
# ---------------------------------------------------------------------------
# Jeton imzalama anahtarı. **Boş bırakılırsa süreç başına rastgele
# üretilir.** Depoya sahte bir varsayılan anahtar konmadı; yanlışlıkla
# üretimde kullanılması, kimlik doğrulamanın hiç olmamasından beterdir.
#
# Sonucu: sunucu yeniden başladığında eski jetonlar geçersizleşir.
# Arayüz bunu sessizce yeniliyor (401 → yeniden oturum), demo bozulmaz;
# ama gerçek dağıtımda bu değer verilmelidir. Uzun ve rastgele olsun:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
NEMEK_TOKEN_SECRET=

# Jeton ömrü, saniye. Varsayılan 8 saat (bir çalışma günü).
NEMEK_TOKEN_TTL_SECONDS=28800

# ---------------------------------------------------------------------------
# Yollar ve veritabanı
# ---------------------------------------------------------------------------
# NEMEK_DATA_DIR=./data
# NEMEK_UPLOAD_DIR=./data/uploads
# NEMEK_INDEX_DIR=./data/index
# NEMEK_CERT_DIR=./backend/certs
# NEMEK_DATABASE_URL=sqlite:///./data/nemek.db

# ---------------------------------------------------------------------------
# Yükleme
# ---------------------------------------------------------------------------
# En büyük kabul edilen yükleme (MB). Docker'daki nginx aynı değeri
# kullanıyor (`client_max_body_size`); ikisi ayrılırsa aynı istek ortama
# göre farklı yerde reddedilir.
# NEMEK_MAX_UPLOAD_MB=32

# Çözülen görüntünün en fazla piksel sayısı. Bayt sınırı tek başına
# yetmiyor: sıkıştırma oranları çok yüksek olabildiği için 32 MB'ı aşmayan
# bir dosya bellekte çok daha büyük bir diziye açılabilir (20000×20000'lik
# düz renkli bir JPEG ~1 MB dosyadır, BGR olarak ~1,2 GB). Sınır görsel
# çözülmeden önce, yalnızca dosya başlığından okunan boyutla uygulanıyor.
# 50 MP tüketici fotoğraf makinelerinin üstünde; gerçek bir kullanıcının
# çarpmayacağı ama bombayı durduran bir eşik.
# NEMEK_MAX_PIXELS=50000000

# ---------------------------------------------------------------------------
# Katkı payı formülü — bunlar *politika* düğmeleri, ölçüm değil
# ---------------------------------------------------------------------------
# ağırlık = kapsama^a × güven^b × sönümleme^(derinlik-1)
# NEMEK_COVERAGE_EXPONENT=1.0
# NEMEK_CONFIDENCE_EXPONENT=1.0

# Zincir sönümlemesi. 1,0 verilirse tamamen kapanır. Agresif bir değer
# (ör. 0,5) tam da bu projenin düzeltmeye çalıştığı haksızlığı üretir:
# ilk üretici, başkaları remixlediği için cezalandırılmış olur.
# NEMEK_CHAIN_DAMPING=0.85
# NEMEK_MAX_CHAIN_DEPTH=5

# Geometrik doğrulama yapılamadığında kullanılan ihtiyatlı kapsama
# varsayımı. Ölçemediğimiz şeyi yüksek varsaymıyoruz.
# NEMEK_UNVERIFIED_COVERAGE=0.35

# Son üreticiye her koşulda bırakılan taban ve alabileceği tavan pay.
# NEMEK_CREATOR_FLOOR=0.20
# NEMEK_CREATOR_CEILING=0.85
# NEMEK_MIN_PAYOUT_SHARE=0.01

# ---------------------------------------------------------------------------
# Köken kurtarma eşikleri
# ---------------------------------------------------------------------------
# NEMEK_MIN_LINK_CONFIDENCE=0.35
# NEMEK_AUTO_CONFIRM_CONFIDENCE=0.85
# NEMEK_MAX_GEOMETRY_CANDIDATES=8
# NEMEK_MIN_COVERAGE_FOR_SHARE=0.03

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# NEMEK_PLATFORM_COMMISSION=0.10
# NEMEK_PLATFORM_NAME=N'Sosyal

# ---------------------------------------------------------------------------
# config.py dışında okunan iki değişken
# ---------------------------------------------------------------------------
# İlk açılışta indirilecek test görseli sayısı — `docker/entrypoint.sh`
# okuyor. Tam değerlendirmeyi (backend/eval) koşacaksanız 320 verin
# (~120 MB). `docker-compose.yml` bunu servis ortamında da veriyor.
# NEMEK_CORPUS_COUNT=24

# Ekran kartı varken bile CPU'ya zorlar — `app/provenance/embedding.py`
# okuyor. CI bunu açıkça veriyor ki test ortamı sessizce değişmesin.
# NEMEK_FORCE_CPU=1
